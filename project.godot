; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tribe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

GraphicsQuality="*res://graphics_quality.gd"
TribeMemory="*res://tribe_memory.gd"
TribeLLM="*res://tribe_llm.gd"
TribeRumor="*res://tribe_rumor.gd"
TribeTalk="*res://tribe_talk.gd"
TribeTTS="*res://tribe_tts.gd"
TribeChorus="*res://tribe_chorus.gd"
TribeCommand="*res://tribe_command.gd"
TribeVoice="*res://tribe_voice.gd"
TribePersist="*res://tribe_persist.gd"
TribeChat="*res://tribe_chat.gd"
TribeTradeUI="*res://tribe_trade_ui.gd"
TribeTradeMenu="*res://tribe_trade_menu.gd"
TribeOverview="*res://tribe_overview.gd"
TribeControlsLegend="*res://tribe_controls_legend.gd"
TribeInventoryUI="*res://tribe_inventory_ui.gd"
TribeDrums="*res://tribe_drums.gd"
TribePoetry="*res://tribe_poetry.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-mcp/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
